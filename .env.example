# --- Telegram (zorunlu) ---
TELEGRAM_BOT_TOKEN=          # @BotFather'dan
TELEGRAM_ADMIN_IDS=          # sizin Telegram kullanıcı ID'niz (birden fazlaysa virgülle)

# --- Müzik (zorunlu) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v1

# --- YouTube (zorunlu; scripts/youtube_auth.py ile alınır) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Önerilen ---
ANTHROPIC_API_KEY=           # başlık/açıklama; yoksa şablon kullanılır
CLAUDE_MODEL=claude-opus-5-5
STABILITY_API_KEY=           # kapak görselleri; yoksa prosedürel arka plan

# --- Kanal profili ---
CHANNEL_PROFILE=focus        # focus = günlük odak müziği · romantic = 1 sa 20 dk – 3 sa+ romantik piyano mixleri
CHANNEL_NAME=                # boşsa profilin varsayılanı (Work Mode & Focus Music / Evermore Romance)

# --- Genel ---
DATA_DIR=/data               # Railway volume bağlama noktası
TIMEZONE=Europe/Istanbul
CONTENT_LANGUAGE=en          # başlık/açıklama dili (global kitle için en)
DRY_RUN=0                    # 1 = YouTube'a yüklemeden uçtan uca dene
